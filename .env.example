ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL. Sustituye los valores; no subas contraseñas reales.
ConnectionStrings__PostgreSQL=Host=TU_HOST;Port=5432;Database=TU_DB;Username=TU_USER;Password=CHANGE_ME_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Timeout=60

# JWT: Jwt__Key debe tener al menos 32 caracteres.
Jwt__Key=CHANGE_ME_GENERA_UNA_CLAVE_LARGA_DE_AL_MENOS_32_CHARS
Jwt__Issuer=SkyHelp
Jwt__Audience=SkyHelp

# Orígenes del frontend (separados por coma).
Cors__AllowedOrigins=https://TU-FRONTEND.onrender.com

Swagger__Enabled=true
